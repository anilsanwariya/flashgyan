# Every setting FlashGyan reads. Never put real secret values in Git.
#
# Public values live in .env (committed; managed by Lovable).
# Secrets are set in Lovable Cloud (Project settings > Secrets), which supplies them to
# the website server and to the Supabase edge function.

# ---- Public: in .env (safe to expose; Row Level Security protects the data) ----
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional Google Analytics 4 id (G-XXXXXXXXXX). Analytics is off when empty.
VITE_GA_MEASUREMENT_ID=

# ---- Secrets: Lovable Cloud only ----
# Full database access for server code and the edge function. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Telegram bot token from @BotFather (bot, Mini App sign-in, broadcasts, channel posts).
TELEGRAM_BOT_TOKEN=
# Claude: all AI text (SAATHI answers, answer checking, magazines, card studio, papers).
ANTHROPIC_API_KEY=
# Google AI Studio: embeddings for SAATHI search (gemini-embedding-001, 1536 dimensions).
GEMINI_API_KEY=
# Lovable AI gateway key. Some AI features still require it to be present.
LOVABLE_API_KEY=
# Tavily: web search and page extraction for current affairs collection.
TAVILY_API_KEY=
# LlamaParse: reading PDFs (SAATHI knowledge-base uploads, current affairs sources).
LLAMA_CLOUD_API_KEY=
# Cloudflare Browser Rendering: magazine PDFs and image cards.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
